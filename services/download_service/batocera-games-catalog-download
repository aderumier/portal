#!/bin/bash
#
# Batocera Games Catalog Download Service
# Init script for /etc/init.d/
#
# chkconfig: 2345 90 10
# description: Batocera Games Catalog Download Service
# processname: download_service.py
# pidfile: /var/run/batocera-games-catalog-download.pid
#

### BEGIN INIT INFO
# Provides:          batocera-games-catalog-download
# Required-Start:     $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:      2 3 4 5
# Default-Stop:       0 1 6
# Short-Description:  Batocera Games Catalog Download Service
# Description:        Service for downloading games from the Batocera Games Catalog queue
### END INIT INFO

# Configuration
SERVICE_NAME="batocera-games-catalog-download"
SERVICE_USER="root"
SERVICE_GROUP="root"
SERVICE_DIR="/userdata/system/rgs/download_service"
SYSTEM_PYTHON="/usr/bin/python3"
SCRIPT_NAME="download_service.py"
PIDFILE="/var/run/${SERVICE_NAME}.pid"
LOCKFILE="/var/lock/subsys/${SERVICE_NAME}"
LOG_FILE="/userdata/system/logs/rgs_download.log"

# Environment variables
export API_URL="${API_URL:-https://rgs-retro.ddns.net}"
export ROMS_PATH="${ROMS_PATH:-/userdata/roms}"
export LOG_LEVEL="${LOG_LEVEL:-INFO}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Source function library (if available)
if [ -f /etc/rc.d/init.d/functions ]; then
    . /etc/rc.d/init.d/functions
elif [ -f /lib/lsb/init-functions ]; then
    . /lib/lsb/init-functions
fi

# Check if service is running
is_running() {
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            return 0
        else
            # Stale PID file
            rm -f "$PIDFILE"
            return 1
        fi
    fi
    return 1
}

# Get process PID
get_pid() {
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            echo "$PID"
            return 0
        fi
    fi
    # Try to find by process name
    PID=$(pgrep -f "download_service.py" | head -n 1)
    if [ -n "$PID" ]; then
        echo "$PID"
        return 0
    fi
    return 1
}

# Start the service
start() {
    echo -n "Starting $SERVICE_NAME: "
    
    if is_running; then
        echo -e "${YELLOW}already running${NC}"
        return 1
    fi
    
    # Check if service directory exists
    if [ ! -d "$SERVICE_DIR" ]; then
        echo -e "${RED}FAILED${NC}"
        echo "Error: Service directory not found: $SERVICE_DIR"
        return 1
    fi
    
    # Check if script exists
    if [ ! -f "$SERVICE_DIR/$SCRIPT_NAME" ]; then
        echo -e "${RED}FAILED${NC}"
        echo "Error: Script not found: $SERVICE_DIR/$SCRIPT_NAME"
        return 1
    fi
    
    # Check if system Python is available
    if [ ! -f "$SYSTEM_PYTHON" ]; then
        echo -e "${RED}FAILED${NC}"
        echo "Error: Python not found: $SYSTEM_PYTHON"
        return 1
    fi
    
    # Create venv if it doesn't exist
    VENV_DIR="${SERVICE_DIR}/.venv"
    if [ ! -f "${VENV_DIR}/bin/python" ]; then
        echo -n "Creating virtual environment... "
        if "$SYSTEM_PYTHON" -m venv "$VENV_DIR" 2>/dev/null; then
            echo -e "${GREEN}OK${NC}"
        else
            echo -e "${YELLOW}WARNING${NC}"
            echo "Warning: Failed to create virtual environment. Will use system Python."
        fi
    fi
    
    # Install/update dependencies if venv exists
    if [ -f "${VENV_DIR}/bin/python" ] && [ -f "${VENV_DIR}/bin/pip" ]; then
        echo -n "Installing/updating dependencies... "
        # Upgrade pip first (quietly)
        "${VENV_DIR}/bin/pip" install --upgrade pip >/dev/null 2>&1 || true
        # Install/update requirements (use --upgrade to ensure new packages are installed)
        # First try quietly, but if it fails, show output
        if "${VENV_DIR}/bin/pip" install --upgrade -r "${SERVICE_DIR}/requirements.txt" >/dev/null 2>&1; then
            echo -e "${GREEN}OK${NC}"
        else
            echo -e "${YELLOW}WARNING${NC}"
            echo "Warning: Silent install failed, retrying with output:"
            "${VENV_DIR}/bin/pip" install --upgrade -r "${SERVICE_DIR}/requirements.txt" || {
                echo -e "${RED}FAILED${NC}"
                echo "Error: Failed to install dependencies. Continuing anyway..."
            }
        fi
    fi
    
    # Use venv Python if available, otherwise fall back to system Python
    if [ -f "${VENV_DIR}/bin/python" ]; then
        PYTHON_BIN="${VENV_DIR}/bin/python"
    else
        PYTHON_BIN="$SYSTEM_PYTHON"
    fi
    
    # Check if API_TOKEN.txt exists
    if [ ! -f "$SERVICE_DIR/API_TOKEN.txt" ]; then
        echo -e "${YELLOW}WARNING${NC}"
        echo "Warning: API_TOKEN.txt not found in $SERVICE_DIR"
        echo "The service may fail to authenticate."
    fi
    
    # Create PID directory if it doesn't exist
    mkdir -p "$(dirname "$PIDFILE")"
    
    # Create log directory if it doesn't exist
    mkdir -p "$(dirname "$LOG_FILE")"
    
    # Start the service
    cd "$SERVICE_DIR" || exit 1
    
    # Run as daemon
    nohup "$PYTHON_BIN" "$SCRIPT_NAME" > /dev/null 2>&1 &
    PID=$!
    
    # Wait a moment to check if process started successfully
    sleep 1
    
    if ps -p "$PID" > /dev/null 2>&1; then
        echo "$PID" > "$PIDFILE"
        touch "$LOCKFILE"
        echo -e "${GREEN}OK${NC} (PID: $PID)"
        return 0
    else
        echo -e "${RED}FAILED${NC}"
        echo "Error: Process failed to start"
        rm -f "$PIDFILE"
        return 1
    fi
}

# Stop the service
stop() {
    echo -n "Stopping $SERVICE_NAME: "
    
    if ! is_running; then
        echo -e "${YELLOW}not running${NC}"
        return 1
    fi
    
    PID=$(get_pid)
    if [ -z "$PID" ]; then
        echo -e "${YELLOW}not running${NC}"
        rm -f "$PIDFILE" "$LOCKFILE"
        return 1
    fi
    
    # Try graceful shutdown first (SIGTERM)
    kill -TERM "$PID" 2>/dev/null
    
    # Wait for process to stop
    for i in {1..10}; do
        if ! ps -p "$PID" > /dev/null 2>&1; then
            break
        fi
        sleep 1
    done
    
    # Force kill if still running
    if ps -p "$PID" > /dev/null 2>&1; then
        echo -n "(force kill) "
        kill -KILL "$PID" 2>/dev/null
        sleep 1
    fi
    
    if ! ps -p "$PID" > /dev/null 2>&1; then
        rm -f "$PIDFILE" "$LOCKFILE"
        echo -e "${GREEN}OK${NC}"
        return 0
    else
        echo -e "${RED}FAILED${NC}"
        return 1
    fi
}

# Restart the service
restart() {
    stop
    sleep 2
    start
}

# Reload configuration (restart for this service)
reload() {
    restart
}

# Show service status
status() {
    echo -n "Status of $SERVICE_NAME: "
    
    if is_running; then
        PID=$(get_pid)
        echo -e "${GREEN}running${NC} (PID: $PID)"
        
        # Show process info
        echo ""
        echo "Process information:"
        ps -p "$PID" -o pid,ppid,user,cmd --no-headers 2>/dev/null || echo "  Unable to get process info"
        
        # Show recent log entries if log file exists
        if [ -f "$LOG_FILE" ]; then
            echo ""
            echo "Recent log entries (last 5 lines):"
            tail -n 5 "$LOG_FILE" | sed 's/^/  /'
        fi
        
        return 0
    else
        echo -e "${RED}stopped${NC}"
        return 1
    fi
}

# Show service logs
logs() {
    if [ -f "$LOG_FILE" ]; then
        if [ "$1" == "-f" ] || [ "$1" == "--follow" ]; then
            tail -f "$LOG_FILE"
        else
            tail -n 50 "$LOG_FILE"
        fi
    else
        echo "Log file not found: $LOG_FILE"
        return 1
    fi
}

# Show usage
usage() {
    cat << EOF
Usage: $0 {start|stop|restart|reload|status|logs|condrestart}

Commands:
    start       Start the service
    stop        Stop the service
    restart     Restart the service
    reload      Reload configuration (restarts the service)
    status      Show service status
    logs        Show service logs (add -f to follow)
    condrestart Restart only if running

Environment variables (can be set in /etc/default/$SERVICE_NAME):
    API_URL                    Backend API URL
    ROMS_PATH                  Path where ROMs are stored
    POLLING_INTERVAL           Queue polling interval (seconds)
    BANDWIDTH_UPDATE_INTERVAL  Bandwidth update interval (seconds)
    LOG_LEVEL                  Logging level (INFO, DEBUG, etc.)

Example:
    $0 start
    $0 status
    $0 logs -f

EOF
}

# Source default configuration if available
if [ -f "/etc/default/$SERVICE_NAME" ]; then
    . "/etc/default/$SERVICE_NAME"
fi

# Main script logic
case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    reload)
        reload
        ;;
    status)
        status
        ;;
    logs)
        logs "$2"
        ;;
    condrestart)
        if is_running; then
            restart
        fi
        ;;
    *)
        usage
        exit 1
        ;;
esac

exit $?

