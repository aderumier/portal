# API Configuration
API_URL=http://localhost
API_TOKEN=your_api_token_here

# Paths
DOWNLOAD_PATH=/path/to/download/directory
GAMES_PATH=/var/roms

# Authentication
SESSION_COOKIE=your_session_cookie_for_auth

# Discord Bot credentials (if needed)
DISCORD_BOT_TOKEN=your_discord_bot_token

# Polling interval in seconds
POLLING_INTERVAL=60

# Logging
LOG_LEVEL=INFO 