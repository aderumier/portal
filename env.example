# =============================================================================
# Batocera Games Catalog - Environment Variables
# =============================================================================
# Copy this file to backend/.env and update the values according to your setup
# =============================================================================

# -----------------------------------------------------------------------------
# Discord OAuth2 Configuration
# -----------------------------------------------------------------------------
# Get these from https://discord.com/developers/applications
# Create a new application and configure OAuth2 redirect URI
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# OAuth2 Redirect URI - must match the one configured in Discord Developer Portal
# This is the backend API endpoint where Discord redirects after authentication
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Bot Token - required for checking user roles and guild membership
# Get from Discord Developer Portal > Your Application > Bot section
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Guild (Server) ID where users must be members
# Right-click your Discord server > Server Settings > Widget > Server ID
DISCORD_GUILD_ID=1006854943157788722

# -----------------------------------------------------------------------------
# Discord Role Mappings
# -----------------------------------------------------------------------------
# Role names required for different features
# These should match the exact role names in your Discord server

# Role name required for download queue access (slow queue)
DISCORD_DOWNLOAD_ROLE=download

# Role name required for fast download queue access
DISCORD_FASTDOWNLOAD_ROLE=fastdownload

# Role name required for admin features (media validation, download queues view)
# Can include spaces and special characters. If needed, you can quote the value:
# DISCORD_ADMIN_ROLE="Retro Games Saviours [RGS]"
# or without quotes (python-dotenv handles spaces):
DISCORD_ADMIN_ROLE=admin

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Path to your Batocera games directory
# This is where gamelist.xml files are located (one per system)
# Example: /home/user/batocera/roms or /mnt/games
GAMES_PATH=/path/to/your/batocera/games

# Path to user-uploaded media (pending validation)
# Users can upload missing game media which is stored here until validated
# Example: /home/user/batocera/users_media
USERS_MEDIA_PATH=/path/to/users/media

# Frontend URL (where users are redirected after authentication)
# In development: http://localhost:3000
# In production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# Backend API URL (used for internal API calls)
# In development: http://localhost:8000
# In production: https://api.yourdomain.com or https://yourdomain.com/api
API_URL=http://localhost:8000

# Public URL for download file endpoint (optional)
# Use this if download service needs to access files from a different domain/port than API_URL
# For example, if API_URL is internal (localhost:8000) but download service is on another machine,
# set this to the public/external URL that the download service can reach
# If not set, defaults to API_URL
# Examples:
#   DOWNLOAD_FILE_URL=https://api.yourdomain.com
#   DOWNLOAD_FILE_URL=http://192.168.1.100:8000
#   DOWNLOAD_FILE_URL=https://downloads.yourdomain.com
DOWNLOAD_FILE_URL=

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# SQLite database URL
# Default: sqlite:///./data/database.sqlite (relative to backend directory)
# For absolute path: sqlite:////absolute/path/to/database.sqlite
DATABASE_URL=sqlite:///./data/database.sqlite

# Secret key for session encryption
# Generate a secure random string (auto-generated by generate-env.sh)
# In production, use a strong random key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production

# -----------------------------------------------------------------------------
# Bandwidth Management
# -----------------------------------------------------------------------------

# Global bandwidth limit in Mbits/s
# Fast queue gets 2/3 of this, slow queue gets the remaining bandwidth
# Examples:
#   1000 = 1 Gbits/s (125 MB/s)
#   10000 = 10 Gbits/s (1.25 GB/s)
#   500 = 500 Mbits/s (62.5 MB/s)
#   100 = 100 Mbits/s (12.5 MB/s)
GLOBAL_BANDWIDTH_LIMIT=1000

# Interval in seconds between bandwidth progress updates
# Download service reports progress every N seconds
BANDWIDTH_UPDATE_INTERVAL=5

# Per-user bandwidth limits for testing (optional, in Mbits/s)
# If not set, users share available bandwidth equally (no per-user limit)
# If set, each user is limited to this bandwidth regardless of available bandwidth
# Examples:
#   PER_USER_SLOW_QUEUE_LIMIT_Mbits=1   # Limit slow queue users to 1 Mbits/s each
#   PER_USER_FAST_QUEUE_LIMIT_Mbits=2  # Limit fast queue users to 2 Mbits/s each
# Leave empty or unset to disable per-user limits (default behavior)
PER_USER_SLOW_QUEUE_LIMIT_Mbits=
PER_USER_FAST_QUEUE_LIMIT_Mbits=

# =============================================================================
# Download Service Configuration
# =============================================================================
# These variables are used by the download_service.py script
# They can be set in the download service's environment or passed when running
# Location: services/download_service/download_service.py

# API URL for the backend (where download_service.py connects)
# API_URL=http://localhost:8000

# Path where downloaded files are saved
# DOWNLOAD_PATH=/var/downloads

# Path to source games (usually same as GAMES_PATH, but can be different)
# GAMES_PATH=/var/roms

# API token for authentication (generate from Account page)
# API_TOKEN=your_api_token_here

# Polling interval in seconds (how often to check for new downloads)
# POLLING_INTERVAL=10

# Service ID to identify this download service instance
# Defaults to hostname if not set
# SERVICE_ID=download-service-1

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

