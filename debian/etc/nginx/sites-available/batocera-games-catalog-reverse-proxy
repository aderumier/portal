# Batocera Games Catalog - Front Reverse Proxy Configuration
# This nginx instance acts as a reverse proxy on a different server
# Proxies requests to the backend server which has:
# - Nginx serving media files and proxying API requests
# - FastAPI backend service on port 8000
# 
# Configuration:
# - BACKEND_SERVER: IP address or hostname of the backend server
# - BACKEND_PORT: Port of the backend nginx (usually 80 or 8080)
# This file should be symlinked to /etc/nginx/sites-enabled/

# Define backend servers (update these with your backend server address)
# Backend server for media and static files (nginx on port 80)
upstream backend_nginx {
    server BACKEND_SERVER_IP:80;  # Replace with actual backend server IP (nginx on port 80)
    # For load balancing, you can add multiple backend servers:
    # server backend1.example.com:80;
    # server backend2.example.com:80;
}

# Backend server for API requests (FastAPI on port 8000)
upstream backend_api {
    server BACKEND_SERVER_IP:8000;  # Replace with actual backend server IP (FastAPI on port 8000)
    # For load balancing, you can add multiple API servers:
    # server backend1.example.com:8000;
    # server backend2.example.com:8000;
}

# HTTP server - redirect to HTTPS and handle Let's Encrypt challenges
server {
    listen 80;
    listen [::]:80;
    server_name _;  # Replace with your domain name

    # Let's Encrypt ACME challenge - serve locally
    location /.well-known/acme-challenge/ {
        root /var/www/html;
        try_files $uri =404;
    }

    # Redirect all other HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server - reverse proxy to backend nginx
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name _;  # Replace with your domain name

    # SSL certificates (managed by certbot)
    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    
    # Include recommended SSL configuration
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Logging
    access_log /var/log/nginx/batocera-games-catalog-reverse-proxy-access.log;
    error_log /var/log/nginx/batocera-games-catalog-reverse-proxy-error.log;

    # Increase max body size for file uploads (pass through to backend)
    client_max_body_size 50M;

    # API requests - proxy directly to FastAPI backend on port 8000
    location /api {
        # Proxy to FastAPI backend server
        proxy_pass http://backend_api;
        
        # Use HTTP/1.1 for backend connection
        proxy_http_version 1.1;
        
        # Headers for backend
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        # WebSocket support (if needed)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Timeouts (increased for large file uploads)
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        # Buffer settings - off for API to avoid buffering issues
        proxy_buffering off;
    }

    # All other requests (media files, static files, frontend) - proxy to backend nginx on port 80
    # The backend nginx handles:
    # - Media files (/media/)
    # - Static frontend files (/)
    location / {
        # Proxy to backend server nginx
        proxy_pass http://backend_nginx;
        
        # Use HTTP/1.1 for backend connection
        proxy_http_version 1.1;
        
        # Headers for backend
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        # WebSocket support (if needed)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Timeouts (increased for large file downloads)
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        # Buffer settings
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
        
        # Don't pass these headers to backend
        proxy_set_header Accept-Encoding "";
    }

    # Let's Encrypt renewal endpoint - serve locally
    location /.well-known/acme-challenge/ {
        root /var/www/html;
        try_files $uri =404;
    }
}

